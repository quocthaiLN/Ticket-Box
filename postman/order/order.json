{
  "info": {
    "_postman_id": "31a576f0-4328-4cc1-91c5-6faaedcf8617",
    "name": "TicketBox - Order API",
    "description": "Collection for testing Order module endpoints (OrderController) in TicketBox project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "",
          "function setNewIdempotencyKey(variableName) {",
          "  const key = pm.variables.replaceIn(\"{{$guid}}\");",
          "  pm.collectionVariables.set(variableName, key);",
          "  pm.request.headers.upsert({ key: \"Idempotency-Key\", value: key });",
          "}",
          "",
          "function reuseIdempotencyKey(variableName) {",
          "  const key = pm.collectionVariables.get(variableName);",
          "  if (!key) {",
          "    throw new Error(\"Run Create Order before running an idempotency retry test.\");",
          "  }",
          "  pm.request.headers.upsert({ key: \"Idempotency-Key\", value: key });",
          "}",
          "",
          "if (requestName === \"Create Order\") {",
          "  setNewIdempotencyKey(\"last_order_idempotency_key\");",
          "} else if (requestName === \"Create Order - Multiple Ticket Types\") {",
          "  setNewIdempotencyKey(\"last_multi_item_idempotency_key\");",
          "} else if (requestName === \"Reject Duplicate Ticket Type in One Order\") {",
          "  setNewIdempotencyKey(\"last_duplicate_ticket_type_idempotency_key\");",
          "} else if (requestName === \"Retry Create Order - Same Idempotency Key\" || requestName === \"Reject Reused Idempotency Key - Different Payload\") {",
          "  reuseIdempotencyKey(\"last_order_idempotency_key\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Order",
      "item": [
